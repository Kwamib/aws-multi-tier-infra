# ==========================================
# Required Variables - Copy to terraform.tfvars and fill in
# ==========================================

# AWS IAM role ARN to assume for provisioning
assume_role_arn = "arn:aws:iam::ACCOUNT_ID:role/YOUR_ROLE"

# Domain name (must have a hosted zone in Route 53)
domain_name = "example.com"

# SSH key pair name (must exist in your AWS account)
key_name = "your-key-pair-name"

# RDS snapshot to restore from
snapshot_identifier = "your-db-snapshot-id"

# Email for CloudWatch alarm notifications
alarm_email = "alerts@example.com"

# Resource ownership
owner_email = "you@example.com"

# ==========================================
# Optional Overrides
# ==========================================

# environment       = "development"
# project_name      = "clixx"
# app_subdomain     = "clixx"
# aws_region        = "us-east-1"
# instance_type     = "t2.micro"
# db_instance_class = "db.m6g.large"
# min_size          = 1
# desired_capacity  = 1
# max_size          = 3
# trusted_ssh_cidr  = "YOUR_IP/32"
# bastion_ami       = "ami-xxxxxxxxx"
